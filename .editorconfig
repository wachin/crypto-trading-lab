# Editor configuration — keep contributions consistent.
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 88

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Trailing spaces are significant in Markdown line breaks.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{ts,qm}]
insert_final_newline = false
